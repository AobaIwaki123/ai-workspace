{
  "$schema": "https://antigravity.google/schemas/permissions.json",
  "name": "Standard Safe Development Preset",
  "description": "Antigravity向けの標準的な安全コマンド許可プリセット（Git、ファイル参照、ビルド、テスト、リント、gh CLI）",
  "permissions": {
    "allow": [
      "command(git status)",
      "command(git diff)",
      "command(git diff .*)",
      "command(git log)",
      "command(git log .*)",
      "command(git show)",
      "command(git show .*)",
      "command(git branch)",
      "command(git branch .*)",
      "command(git checkout .*)",
      "command(git switch .*)",
      "command(git rev-parse .*)",
      "command(git remote .*)",
      "command(git add .*)",
      "command(git commit .*)",
      "command(ls)",
      "command(ls .*)",
      "command(pwd)",
      "command(cat .*)",
      "command(head .*)",
      "command(tail .*)",
      "command(grep .*)",
      "command(find .*)",
      "command(which .*)",
      "command(tree)",
      "command(tree .*)",
      "command(wc .*)",
      "command(echo .*)",
      "command(npm test)",
      "command(npm test .*)",
      "command(npm run test.*)",
      "command(npm run lint.*)",
      "command(npm run build.*)",
      "command(npm run format.*)",
      "command(npm run check.*)",
      "command(npm list)",
      "command(npm list .*)",
      "command(npx .*)",
      "command(node .*)",
      "command(gh pr view .*)",
      "command(gh pr list.*)",
      "command(gh pr diff.*)",
      "command(gh pr status.*)",
      "command(gh pr create.*)",
      "command(gh issue list.*)",
      "command(gh issue view .*)",
      "command(gh auth status.*)",
      "command(./scripts/.*)",
      "command(bash ./scripts/.*)"
    ],
    "deny": [
      "command(rm -rf /)",
      "command(rm -rf ~.*)",
      "command(rm -rf \\*)",
      "command(git push.*--force.*)",
      "command(git push.*-f .*)",
      "command(git reset --hard.*)",
      "command(git clean -fd.*)",
      "command(mkfs.*)",
      "command(dd .*)"
    ]
  }
}
