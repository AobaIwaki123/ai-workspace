{
  "permissions": {
    "allow": [
      "command(git status)",
      "command(git diff)",
      "command(git diff .*)",
      "command(git log)",
      "command(git log .*)",
      "command(git show)",
      "command(git show .*)",
      "command(git branch)",
      "command(git branch .*)",
      "command(git checkout .*)",
      "command(git switch .*)",
      "command(git rev-parse .*)",
      "command(git remote .*)",
      "command(git add .*)",
      "command(git commit .*)",
      "command(ls)",
      "command(ls .*)",
      "command(pwd)",
      "command(cat .*)",
      "command(head .*)",
      "command(tail .*)",
      "command(grep .*)",
      "command(find .*)",
      "command(which .*)",
      "command(tree)",
      "command(tree .*)",
      "command(wc .*)",
      "command(echo .*)",
      "command(npm test)",
      "command(npm test .*)",
      "command(npm run lint.*)",
      "command(npm run build.*)",
      "command(npm run check.*)",
      "command(npm list)",
      "command(npx .*)",
      "command(node .*)",
      "command(gh pr .*)",
      "command(gh issue .*)",
      "command(gh auth .*)",
      "command(./scripts/.*)"
    ],
    "deny": [
      "command(rm -rf /)",
      "command(rm -rf ~.*)",
      "command(git push.*--force.*)",
      "command(git push.*-f .*)",
      "command(git reset --hard.*)",
      "command(git clean -fd.*)"
    ]
  }
}
